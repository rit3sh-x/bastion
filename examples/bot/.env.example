# Copy to .env and fill in.
# Chain config (RPC, owner wallet, SPL mint) is generated by the provisioner
# into examples/bot/temp/ — only the LLM settings live here.

# Required. API key for the LLM. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Model — must support tool/function calling. Default: llama-3.3-70b-versatile
# MODEL=llama-3.3-70b-versatile

# Optional. Max tool steps the agent may take per user turn. Default: 8.
# MAX_STEPS=8
