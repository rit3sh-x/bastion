        "groq-sdk": "^1.2.0",
        "zod": "^4.4.0"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@workspace/typescript-config": "workspace:*",
        "tsx": "^4.19.0",
        "typescript": "^6.0.0"
    }
