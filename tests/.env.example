# Copy to .env for the devnet E2E test package.

# Required opt-in. Without this, live devnet tests are skipped.
BASTION_DEVNET_E2E=1

# Required wallet. Use either OWNER_SECRET or OWNER_KEYPAIR.
# OWNER_SECRET is a base58-encoded 64-byte Solana keypair.
OWNER_SECRET=

# Alternative to OWNER_SECRET. Defaults to ~/.config/solana/id.json if unset.
# OWNER_KEYPAIR=~/.config/solana/id.json

# Optional. Defaults to https://api.devnet.solana.com.
# A dedicated endpoint (e.g. Helius devnet) is strongly recommended — the public
# endpoint rate-limits aggressively and will stall the suite.
RPC_URL=https://api.devnet.solana.com

# Optional RPC pacing (see src/setup-rpc-throttle.ts). All RPC traffic is spaced
# to stay under the provider's per-second cap and 429s are retried with backoff,
# so a rate-limit error never masquerades as a policy rejection.
# RPC_MAX_RPS caps requests/second (Helius free tier is ~10; default 8).
# RPC_MAX_RETRIES bounds the 429/503 backoff retries (default 8).
# RPC_MAX_RPS=8
# RPC_MAX_RETRIES=8
