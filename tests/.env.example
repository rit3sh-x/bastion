# Copy to .env for the devnet E2E test package.

# Required opt-in. Without this, live devnet tests are skipped.
BASTION_DEVNET_E2E=1

# Required wallet. Use either OWNER_SECRET or OWNER_KEYPAIR.
# OWNER_SECRET is a base58-encoded 64-byte Solana keypair.
OWNER_SECRET=

# Alternative to OWNER_SECRET. Defaults to ~/.config/solana/id.json if unset.
# OWNER_KEYPAIR=~/.config/solana/id.json

# Optional. Defaults to https://api.devnet.solana.com.
RPC_URL=https://api.devnet.solana.com
